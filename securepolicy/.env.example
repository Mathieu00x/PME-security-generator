# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Have I Been Pwned (optional — domain-search requires a paid, domain-verified
# subscription; the scan degrades gracefully if this is unset)
HIBP_API_KEY=your_hibp_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin-only maintenance endpoints (e.g. seed-kb-controls). Unlike CRON_SECRET,
# this fails CLOSED (503) if unset — see the route's own comment for why.
# Generate with: openssl rand -hex 32
ADMIN_SECRET_TOKEN=your_admin_secret_token
